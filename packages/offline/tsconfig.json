{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ],
  // Store-backed suites import `@rstore/vue` and `#test-utils`; they are
  // type-checked by the root `tsconfig.integration.json`.
  "exclude": [
    "test/integration"
  ]
}
