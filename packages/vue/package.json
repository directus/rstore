{
  "name": "@rstore/vue",
  "type": "module",
  "version": "0.8.4",
  "description": "Reactive Store for Vue",
  "repository": {
    "url": "https://github.com/Akryum/rstore.git",
    "type": "git",
    "directory": "packages/vue"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "benchmark:write-items": "vite-node benchmark/write-items-publication.ts",
    "build": "unbuild",
    "dev": "unbuild --stub && printf \"export * from '../src/index'\" > ./dist/index.mjs",
    "prepack": "node ../../scripts/sync-dep-skills.mjs .",
    "benchmark": "vite-node benchmark/cache.bench.ts",
    "benchmark:decomposition": "vite-node benchmark/decomposition.ts",
    "benchmark:read-decomposition": "vite-node benchmark/read-decomposition.ts",
    "benchmark:read-regressions": "vite-node benchmark/read-regressions.ts",
    "benchmark:engine-profile": "vite-node benchmark/engine-profile.ts",
    "benchmark:write-decomposition": "vite-node benchmark/write-decomposition.ts",
    "benchmark:combine-reports": "vite-node benchmark/combine-version-reports.ts",
    "benchmark:full": "vite-node benchmark/full.ts",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.21"
  },
  "dependencies": {
    "@rstore/core": "workspace:^",
    "@rstore/shared": "workspace:^",
    "@vueuse/core": "^14.0.0",
    "fast-equals": "^5.3.3",
    "klona": "^2.0.6"
  },
  "devDependencies": {
    "tinybench": "^2.9.0",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
