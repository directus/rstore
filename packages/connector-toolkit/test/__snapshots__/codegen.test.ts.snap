  name: "posts",
  scopeId: "test-scope",
  meta: {"primaryKeys":["id"]},
  relations: {"author":{"to":{"users":{"on":{"id":"author_id"}}}}},
  getKey: (item) => item.id,
}
export const collection1 = {
  name: "users",
