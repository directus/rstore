{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "*": ["./*"],
      "@rstore/directus": [
        "./../directus/src/index"
      ],
      "@rstore/directus/schema": [
        "./../directus/src/schema/index"
      ]
    },
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}
