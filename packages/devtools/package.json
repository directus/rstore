{
  "name": "@rstore/devtools",
  "type": "module",
  "version": "0.8.4",
  "description": "Portable rstore inspection, Devframe integration, and development tooling",
  "repository": {
    "url": "https://github.com/Akryum/rstore.git",
    "type": "git",
    "directory": "packages/devtools"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.mts",
      "import": "./dist/browser/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.mts",
      "import": "./dist/vue/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.mts",
      "import": "./dist/protocol/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "rstore-devtools": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "unbuild && vite build",
    "dev": "vite --host 127.0.0.1",
    "dev:prepare": "unbuild --stub",
    "test:types": "tsrs --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.client.json"
  },
  "peerDependencies": {
    "vite": "^8.2.2",
    "vue": "^3.5.21"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@devframes/agentic": "catalog:",
    "@rstore/core": "workspace:^",
    "@rstore/shared": "workspace:^",
    "cac": "catalog:",
    "devframe": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@nuxt/ui": "catalog:",
    "@rstore/vue": "workspace:^",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
