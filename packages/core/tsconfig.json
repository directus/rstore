{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    // The shared test helpers in `test/utils/`, imported as `#test-utils/…`.
    // Resolved relative to this file: under `moduleResolution: "Node"`, `paths`
    // is consulted before any `imports`-field handling, so no `baseUrl` is needed.
    "paths": {
      "#test-utils/*": [
        "../../test/utils/*"
      ]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    // Imports @rstore/vue sources and the shared root test utils, which only
    // type-check in their own package context.
    "test/integration"
  ]
}
